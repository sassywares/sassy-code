#!/usr/bin/env bash
# main: left pane = session control panel, right pane = session viewer.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANEL_CMD="$(printf 'python3 %q' "$DIR/panel.py")"
SESSION="sassy-code"
WIDTH="${SASSY_CODE_WIDTH:-22%}"

ensure_extended_keys() {
  # Recommended by `docs/tmux.md` so modified Enter works inside Pi.
  tmux set-option -g extended-keys on 2>/dev/null || true
  tmux set-option -g extended-keys-format csi-u 2>/dev/null || true
}

ensure_pane_keys() {
  # tmux's default prefix+arrow bindings repeat for 500 ms. After switching
  # panes, the next arrow is still consumed by the prefix table instead of
  # reaching the panel. Disable repeat only for those default bindings; match
  # the exact command so custom prefix+arrow bindings are left alone.
  local key dir binding
  for key in Up Down Left Right; do
    dir="${key:0:1}"   # tmux pane directions: Up→U, Down→D, Left→L, Right→R
    binding="$(tmux list-keys -T prefix -F '#{key_repeat} #{key_command}' "$key" 2>/dev/null || true)"
    if [ "$binding" = "1 select-pane -$dir" ]; then
      tmux bind-key -T prefix "$key" select-pane "-$dir" 2>/dev/null || true
    fi
  done
}

ensure_new_session_key() {
  # A key in the prefix table that runs the panel's `n` binding from anywhere
  # in the window, so no focus change is needed. Never take a key that is
  # already bound: tmux defaults and the user's bindings win.
  local key="${SASSY_CODE_NEW_KEY:-N}" current
  current="$(tmux list-keys -T prefix -F '#{key_command}' "$key" 2>/dev/null || true)"
  if [ -n "$current" ]; then
    case "$current" in
      *--new-session*) ;;   # ours already; refresh the path below
      *)
        printf 'sassy-code: prefix+%s is already bound; not overriding it\n' \
          "$key" >&2
        return 0
        ;;
    esac
  fi
  tmux bind-key -T prefix "$key" run-shell -b \
    "$PANEL_CMD --new-session --pane #{pane_id}" 2>/dev/null || true
}

ensure_tmux_config() {
  ensure_extended_keys
  ensure_pane_keys
  ensure_new_session_key
}

if [ "${SASSY_CODE_TMUX_CONFIG_ONLY:-}" = "1" ]; then
  # `start-server` exits immediately without sessions unless exit-empty is
  # disabled in the same command sequence. Doing so keeps the cold-started
  # server alive long enough to apply and inspect the configuration.
  if ! tmux list-sessions >/dev/null 2>&1; then
    if ! err="$(tmux start-server \; set-option -g exit-empty off 2>&1)"; then
      printf 'sassy-code: failed to start a tmux server: %s\n' \
        "${err:-tmux start-server failed}" >&2
      exit 1
    fi
  fi
  ensure_tmux_config
  exit 0
fi

current_session() {
  # The session the launcher runs in; empty outside tmux.
  [ -n "${TMUX:-}" ] || return 0
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || true
  else
    tmux display-message -p '#{session_name}' 2>/dev/null || true
  fi
}

PANEL_STARTING_SECS=10

has_live_panel() {
  # A pane tagged @sassy_panel that is running Python (the panel itself), or
  # one the launcher marked with its start time in the last few seconds, before
  # Python is in the foreground. A mark that never became a running panel
  # (startup crash) ages out, so the rebuild path still works.
  local now cmd mark age
  now="$(date +%s)"
  while IFS='|' read -r cmd mark; do
    [ -n "$mark" ] || continue
    case "$cmd" in *[Pp]ython*) return 0 ;; esac
    case "$mark" in ''|*[!0-9]*) continue ;; esac
    # 10# forces base 10 so a mark like 09 is not read as bad octal.
    age=$((now - 10#$mark))
    if [ "$age" -ge 0 ] && [ "$age" -le "$PANEL_STARTING_SECS" ]; then
      return 0
    fi
  done < <(tmux list-panes -s -t "=$SESSION" \
    -F '#{pane_current_command}|#{@sassy_panel}' 2>/dev/null)
  return 1
}

build_layout() {
  # Left pane = panel, right pane = viewer, in a window of the dedicated
  # session. Creates the session when it is missing; otherwise adds a window,
  # so a session left without a panel (e.g. after a crash) is rebuilt. The old
  # panel-less window is kept, so any agent in it survives.
  local WIN SESS PANEL_PANE
  if tmux has-session -t "=$SESSION" 2>/dev/null; then
    WIN="$(tmux new-window -d -t "=$SESSION:" -n sassy-code -P -F '#{window_id}')"
  else
    WIN="$(tmux new-session -d -s "$SESSION" -n sassy-code -P -F '#{window_id}')"
  fi
  SESS="$(tmux list-panes -t "$WIN" -F '#{pane_id}' | head -1)"
  PANEL_PANE="$(tmux split-window -h -b -t "$WIN" -l "$WIDTH" -P -F '#{pane_id}')"
  # Mark the pane before the panel starts so a second launch right now sees it.
  tmux set-option -p -t "$PANEL_PANE" @sassy_panel "$(date +%s)"
  # After the panel exits only its own pane goes: never kill the window, which
  # may hold a live viewer agent. (q only detaches; the panel keeps running.)
  tmux send-keys -t "$PANEL_PANE" \
    "$PANEL_CMD --target $(printf '%q' "$SESS"); tmux kill-pane -t $(printf '%q' "$PANEL_PANE")" Enter
  tmux select-window -t "$WIN"
  tmux select-pane -t "$PANEL_PANE"   # panel owns the keyboard until Enter
}

# sassy-code only lives in its own dedicated session; it never splits the
# window it was run from.
if [ "$(current_session)" != "$SESSION" ]; then
  if ! tmux has-session -t "=$SESSION" 2>/dev/null || ! has_live_panel; then
    build_layout
  fi
  ensure_tmux_config
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$SESSION" 2>/dev/null || true
  else
    exec tmux attach -t "=$SESSION"
  fi
else
  # Already inside the dedicated session: never add a second panel.
  ensure_tmux_config
  if ! has_live_panel; then
    build_layout
  fi
fi
