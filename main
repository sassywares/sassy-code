#!/usr/bin/env bash
# main: left pane = session control panel, right pane = active session.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANEL_CMD="python3 '$DIR/panel.py'"
SESSION="sassy-pi"
WIDTH="${SASSY_PI_WIDTH:-22%}"

ensure_extended_keys() {
  # Recommended by `docs/tmux.md` so modified Enter works inside Pi.
  tmux set-option -g extended-keys on 2>/dev/null || true
  tmux set-option -g extended-keys-format csi-u 2>/dev/null || true
}

ensure_pane_keys() {
  # tmux's default prefix+arrow bindings repeat for 500 ms. After switching
  # panes, the next arrow is still consumed by the prefix table instead of
  # reaching the panel. Disable repeat only for those default bindings; match
  # the exact command so custom prefix+arrow bindings are left alone.
  local key dir binding
  for key in Up Down Left Right; do
    dir="${key:0:1}"   # tmux pane directions: Up→U, Down→D, Left→L, Right→R
    binding="$(tmux list-keys -T prefix -F '#{key_repeat} #{key_command}' "$key" 2>/dev/null || true)"
    if [ "$binding" = "1 select-pane -$dir" ]; then
      tmux bind-key -T prefix "$key" select-pane "-$dir" 2>/dev/null || true
    fi
  done
}

ensure_tmux_config() {
  ensure_extended_keys
  ensure_pane_keys
}

if [ "${SASSY_PI_TMUX_CONFIG_ONLY:-}" = "1" ]; then
  # `start-server` exits immediately without sessions unless exit-empty is
  # disabled in the same command sequence. Doing so keeps the cold-started
  # server alive long enough to apply and inspect the configuration.
  if ! tmux list-sessions >/dev/null 2>&1; then
    if ! err="$(tmux start-server \; set-option -g exit-empty off 2>&1)"; then
      printf 'sassy-pi: failed to start a tmux server: %s\n' \
        "${err:-tmux start-server failed}" >&2
      exit 1
    fi
  fi
  ensure_tmux_config
  exit 0
fi

if [ -n "${TMUX:-}" ]; then
  # Already inside tmux: keep this pane as the session view, add a narrow
  # panel pane to its left.
  ensure_tmux_config
  SESS="$TMUX_PANE"
  PANEL_PANE="$(tmux split-window -h -b -l "$WIDTH" -P -F '#{pane_id}')"
  tmux select-pane -t "$PANEL_PANE"
  $PANEL_CMD --target "$SESS"
  tmux select-pane -t "$SESS" 2>/dev/null || true
else
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -n sassy-pi
    WIN="$(tmux list-windows -t "$SESSION" -F '#{window_id}' | head -1)"
    SESS="$(tmux list-panes -t "$WIN" -F '#{pane_id}' | head -1)"
    PANEL_PANE="$(tmux split-window -h -b -t "$WIN" -l "$WIDTH" -P -F '#{pane_id}')"
    tmux send-keys -t "$PANEL_PANE" \
      "$PANEL_CMD --target '$SESS'; tmux kill-window -t '$WIN'" Enter
    tmux select-pane -t "$PANEL_PANE"   # panel owns the keyboard until Enter
  fi
  ensure_tmux_config
  exec tmux attach -t "$SESSION"
fi
